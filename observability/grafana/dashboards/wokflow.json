      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"wokflow-api\",uri!~\"/actuator.*|.*/events\"}[5m])))",
